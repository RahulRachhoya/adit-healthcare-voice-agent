# Copy to .env; keep all actual secrets out of version control.
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
# Matches the local PostgreSQL service in compose.yaml.
DATABASE_URL=postgresql+psycopg://adit:local-development-only@127.0.0.1:5432/adit
SESSION_SECRET=
ADMIN_USERNAME=operator
# Generate with: uv run adit-password (password is prompted, not a command argument).
ADMIN_PASSWORD_HASH=
COOKIE_SECURE=false
ALLOWED_HOSTS=127.0.0.1,localhost

# Calls remain disabled until the documented manual preflight has succeeded.
LIVE_CALLS_ENABLED=false
FREE_TRIAL_VERIFIED=false
ALLOWED_PHONE_NUMBERS=
MAX_CALL_ATTEMPTS=10
MAX_CALL_SECONDS=180

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=adit-healthcare
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_DESTINATION_COUNTRY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional independent fallback for conversation and post-call analysis.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Separate analysis model avoids consuming the voice model's request quota.
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
STT_MODEL=deepgram/nova-3
TTS_MODEL=cartesia/sonic-3
# Set a Cartesia voice ID from the LiveKit supported voice catalog.
TTS_VOICE=

# Private Supabase bucket using its S3-compatible endpoint.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RECORDING_BUCKET=call-recordings
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=adit-healthcare
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
OPIK_WEB_URL=https://www.comet.com/opik
# Paste the ID returned after configuring the online evaluation rule.
OPIK_RULE_ID=
