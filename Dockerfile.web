FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.12.11 /uv /uvx /bin/
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src ./src
COPY migrations ./migrations
COPY examples ./examples
COPY alembic.ini ./
RUN uv sync --frozen --no-dev && useradd --create-home app
USER app
CMD ["sh", "-c", "/app/.venv/bin/uvicorn adit_voice_agent.web.app:create_app --factory --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers"]
